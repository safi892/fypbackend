# ==============================================================================
# FYP Backend Environment Configuration
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env (Linux/macOS)
#   copy .env.example .env (Windows)
# ==============================================================================

# Server Port (default: 8000)
PORT=8000

# Model Backend Selection
# Options:
#   cpp_reviewer_gguf (default, high-performance GGUF via llama-server)
#   qwen_gguf         (backward-compatible alias)
#   llm_gguf          (generic LLM GGUF alias)
#   codet5            (legacy local PyTorch model, requires GPU/checkpoint)
MODEL_BACKEND=cpp_reviewer_gguf

# llama.cpp Model Inference Server Settings
# URL where llama-server is listening (default: http://127.0.0.1:8081)
LLAMA_SERVER_URL=http://127.0.0.1:8081

# Path to the GGUF model weights
# Place your trained .gguf model in models/gguf/
LLAMA_MODEL_PATH=models/gguf/cpp-review-v3-q4_k_m.gguf

# Number of CPU threads for inference (default: 8)
LLAMA_THREADS=8

# Context window size in tokens (default: 4096)
LLAMA_CONTEXT=4096

# Request timeout in seconds for inference (default: 180)
LLAMA_TIMEOUT=180

# Roman Urdu Translation Model Path (optional, for Roman Urdu explanations)
ROMAN_URDU_MODEL_PATH=models/roman-model/t5-stage2-c

# SQLite Database File Path (default: app.db in root)
DB_PATH=app.db

# User Session Duration in Hours (default: 720 = 30 days)
SESSION_TTL_HOURS=720
